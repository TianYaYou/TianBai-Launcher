                                    </Expander>
                                </StackPanel>

                                <StackPanel x:Name="AboutSettingsPanel" Visibility="Collapsed">
                                    <StackPanel>
                                        <Border Style="{StaticResource PowerToysItemBorderStyle}">
                                            <StackPanel Style="{StaticResource PowerToysTitleStackStyle}">
                                                <TextBlock Text="项目信息" Style="{StaticResource PowerToysTitleStyle}" Margin="0,0,0,4" />
                                                <TextBlock x:Name="AboutProjectInfoTextBlock" Style="{StaticResource PowerToysSubtitleStyle}" />
                                            </StackPanel>
                                        </Border>
                                        <Border Style="{StaticResource PowerToysItemBorderStyle}">
                                            <StackPanel Style="{StaticResource PowerToysTitleStackStyle}">
                                                <TextBlock Text="当前状态" Style="{StaticResource PowerToysTitleStyle}" Margin="0,0,0,4" />
                                                <TextBlock x:Name="AboutResourceModeTextBlock" TextWrapping="Wrap" />
                                                <TextBlock x:Name="AboutVersionTextBlock" Style="{StaticResource PowerToysSubtitleStyle}" Margin="0,4,0,0" />
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>

                                    <Expander Style="{StaticResource PowerToysExpanderStyle}">
                                        <Expander.Header>
                                            <Grid MinHeight="72">
                                                <StackPanel Style="{StaticResource PowerToysTitleStackStyle}">
                                                    <TextBlock Text="开发与路径诊断信息" Style="{StaticResource PowerToysTitleStyle}" />
                                                    <TextBlock Text="查看底层程序关联与配置文件绝对路径" Style="{StaticResource PowerToysSubtitleStyle}" />
                                                </StackPanel>
                                            </Grid>
                                        </Expander.Header>
                                        <StackPanel Padding="0,4,0,8">
                                            <Border Style="{StaticResource PowerToysInnerItemBorderStyle}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="300"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="游戏程序" Style="{StaticResource PowerToysInnerTitleStyle}" />
                                                    <TextBox Grid.Column="1" x:Name="AboutGamePathTextBox" IsReadOnly="True" TextWrapping="NoWrap" VerticalAlignment="Center" />
                                                </Grid>
                                            </Border>
                                            <Border Style="{StaticResource PowerToysInnerItemBorderStyle}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="300"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="StreamingAssets" Style="{StaticResource PowerToysInnerTitleStyle}" />
                                                    <TextBox Grid.Column="1" x:Name="AboutStreamingAssetsTextBox" IsReadOnly="True" TextWrapping="NoWrap" VerticalAlignment="Center" />
                                                </Grid>
                                            </Border>
                                            <Border Style="{StaticResource PowerToysInnerItemBorderStyle}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="300"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="AI 配置" Style="{StaticResource PowerToysInnerTitleStyle}" />
                                                    <TextBox Grid.Column="1" x:Name="AboutAiConfigTextBox" IsReadOnly="True" TextWrapping="NoWrap" VerticalAlignment="Center" />
                                                </Grid>
                                            </Border>
                                            <Border Style="{StaticResource PowerToysInnerItemBorderStyle}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="300"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="TTS 配置" Style="{StaticResource PowerToysInnerTitleStyle}" />
                                                    <TextBox Grid.Column="1" x:Name="AboutTtsConfigTextBox" IsReadOnly="True" TextWrapping="NoWrap" VerticalAlignment="Center" />
                                                </Grid>
                                            </Border>
                                            <Border Style="{StaticResource PowerToysInnerItemBorderStyle}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="300"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="Wisper 配置" Style="{StaticResource PowerToysInnerTitleStyle}" />
                                                    <TextBox Grid.Column="1" x:Name="AboutWhisperConfigTextBox" IsReadOnly="True" TextWrapping="NoWrap" VerticalAlignment="Center" />
                                                </Grid>
                                            </Border>
                                            <Border Style="{StaticResource PowerToysInnerItemBorderStyle}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="300"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="Memory" Style="{StaticResource PowerToysInnerTitleStyle}" />
                                                    <TextBox Grid.Column="1" x:Name="AboutMemoryPathTextBox" IsReadOnly="True" TextWrapping="NoWrap" VerticalAlignment="Center" />
                                                </Grid>
                                            </Border>
                                            <Border Style="{StaticResource PowerToysInnerItemBorderStyle}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="300"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="Unity 日志" Style="{StaticResource PowerToysInnerTitleStyle}" />
                                                    <TextBox Grid.Column="1" x:Name="AboutUnityLogPathTextBox" IsReadOnly="True" TextWrapping="NoWrap" VerticalAlignment="Center" />
                                                </Grid>
                                            </Border>
                                            <Border Style="{StaticResource PowerToysInnerItemBorderStyle}" BorderThickness="0">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="300"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="启动器配置" Style="{StaticResource PowerToysInnerTitleStyle}" />
                                                    <TextBox Grid.Column="1" x:Name="AboutLauncherSettingsPathTextBox" IsReadOnly="True" TextWrapping="NoWrap" VerticalAlignment="Center" />
                                                </Grid>
                                            </Border>
                                        </StackPanel>
                                    </Expander>

                                    <InfoBar IsOpen="True" IsClosable="False" Severity="Informational" Title="提示" Message="如果启动后语音、TTS、记忆或 AI 配置没有生效，请先检查这里的 StreamingAssets 是否指向当前正在运行的游戏目录。" Margin="1,16,1,0" />
                                </StackPanel>

                                <StackPanel x:Name="ExtraModuleSettingsPanel" Visibility="Collapsed">
                                    <Border Style="{StaticResource PowerToysItemBorderStyle}">
                                        <StackPanel Style="{StaticResource PowerToysTitleStackStyle}">
                                            <TextBlock Text="额外模块暂时先不开发。" Style="{StaticResource PowerToysTitleStyle}" />
                                            <TextBlock Text="之后这里可以接插件、工具队列和模块管理。" Style="{StaticResource PowerToysSubtitleStyle}" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </ScrollViewer>

                        <Border x:Name="EditableActionBar" Grid.Row="3" Padding="0,14,0,0" Visibility="Collapsed">
                            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Spacing="8">
                                <Button x:Name="DiscardChangesButton" Click="DiscardChangesButton_Click" Content="放弃保存" />
                                <Button x:Name="SaveChangesButton" Click="SaveChangesButton_Click" Content="保存更改" Style="{StaticResource AccentButtonStyle}" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </NavigationView>
            </Border>
        </Grid>
    </Grid>
</Window>