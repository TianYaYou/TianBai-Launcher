                                                    <ComboBoxItem Content="远端 URL/API" Tag="0" />
                                                    <ComboBoxItem Content="本地 sherpa-onnx" Tag="1" />
                                                </ComboBox>
                                            </Grid>
                                        </Border>
                                    </StackPanel>

                                    <StackPanel Style="{StaticResource PowerToysGroupStackStyle}">
                                        <TextBlock Text="远端 API 设置" FontWeight="SemiBold" FontSize="14" Margin="4,0,0,8" />
                                        <Border Style="{StaticResource PowerToysItemBorderStyle}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="300"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="远端 API Key" VerticalAlignment="Center" FontWeight="Medium" />
                                                <PasswordBox Grid.Column="1" x:Name="TtsApiKeyPasswordBox" PasswordChanged="EditableRoutedChanged" VerticalAlignment="Center" />
                                            </Grid>
                                        </Border>
                                        <Border Style="{StaticResource PowerToysItemBorderStyle}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="300"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="远端 API Host" VerticalAlignment="Center" FontWeight="Medium" />
                                                <TextBox Grid.Column="1" x:Name="TtsApiHostTextBox" TextChanged="EditableTextChanged" VerticalAlignment="Center" />
                                            </Grid>
                                        </Border>
                                        <Border Style="{StaticResource PowerToysItemBorderStyle}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="300"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="远端 API Path" VerticalAlignment="Center" FontWeight="Medium" />
                                                <TextBox Grid.Column="1" x:Name="TtsApiPathTextBox" TextChanged="EditableTextChanged" VerticalAlignment="Center" />
                                            </Grid>
                                        </Border>
                                        <Border Style="{StaticResource PowerToysItemBorderStyle}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="300"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="远端模型" VerticalAlignment="Center" FontWeight="Medium" />
                                                <TextBox Grid.Column="1" x:Name="TtsModelTextBox" TextChanged="EditableTextChanged" VerticalAlignment="Center" />
                                            </Grid>
                                        </Border>
                                        <Border Style="{StaticResource PowerToysItemBorderStyle}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="300"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="音频格式" VerticalAlignment="Center" FontWeight="Medium" />
                                                <TextBox Grid.Column="1" x:Name="TtsAudioFormatTextBox" TextChanged="EditableTextChanged" VerticalAlignment="Center" />
                                            </Grid>
                                        </Border>
                                    </StackPanel>

                                    <StackPanel Style="{StaticResource PowerToysGroupStackStyle}">
                                        <Border Style="{StaticResource PowerToysItemBorderStyle}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="200"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="兜底采样率" VerticalAlignment="Center" FontWeight="Medium" />
                                                <NumberBox Grid.Column="1" x:Name="TtsFallbackSampleRateNumberBox" Minimum="8000" Maximum="96000" ValueChanged="EditableNumberChanged" VerticalAlignment="Center" />
                                            </Grid>
                                        </Border>
                                        <Border Style="{StaticResource PowerToysItemBorderStyle}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="200"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="兜底声道数" VerticalAlignment="Center" FontWeight="Medium" />
                                                <NumberBox Grid.Column="1" x:Name="TtsFallbackChannelsNumberBox" Minimum="1" Maximum="2" ValueChanged="EditableNumberChanged" VerticalAlignment="Center" />
                                            </Grid>
                                        </Border>
                                        <Border Style="{StaticResource PowerToysItemBorderStyle}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="300"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="默认情感" VerticalAlignment="Center" FontWeight="Medium" />
                                                <TextBox Grid.Column="1" x:Name="TtsDefaultEmotionTextBox" TextChanged="EditableTextChanged" VerticalAlignment="Center" />
                                            </Grid>
                                        </Border>
                                        <Border Style="{StaticResource PowerToysItemBorderStyle}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="把情感追加到声音描述" VerticalAlignment="Center" FontWeight="Medium" />
                                                <ToggleSwitch Grid.Column="1" x:Name="TtsAppendEmotionSwitch" Toggled="EditableRoutedChanged" VerticalAlignment="Center" Margin="0" />
                                            </Grid>
                                        </Border>
                                        <Border Style="{StaticResource PowerToysItemBorderStyle}">
                                            <StackPanel Spacing="8">
                                                <TextBlock Text="基础声音描述" FontWeight="Medium" />
                                                <TextBox x:Name="TtsBaseVoiceDescriptionTextBox" AcceptsReturn="True" Height="100" TextWrapping="Wrap" TextChanged="EditableTextChanged" />
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>

                                    <StackPanel Style="{StaticResource PowerToysGroupStackStyle}">
                                        <TextBlock Text="Sherpa-onnx 本地模型设置" FontWeight="SemiBold" FontSize="14" Margin="4,0,0,8" />

                                        <Border Style="{StaticResource PowerToysItemBorderStyle}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="300"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Sherpa 模型目录" VerticalAlignment="Center" FontWeight="Medium" />
                                                <TextBox Grid.Column="1" x:Name="TtsSherpaModelRootTextBox" TextChanged="EditableTextChanged" VerticalAlignment="Center" />
                                            </Grid>
                                        </Border>
                                        <Border Style="{StaticResource PowerToysItemBorderStyle}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="300"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Sherpa 模型文件" VerticalAlignment="Center" FontWeight="Medium" />
                                                <TextBox Grid.Column="1" x:Name="TtsSherpaModelFileTextBox" TextChanged="EditableTextChanged" VerticalAlignment="Center" />
                                            </Grid>
                                        </Border>
                                        <Border Style="{StaticResource PowerToysItemBorderStyle}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="300"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Tokens 文件" VerticalAlignment="Center" FontWeight="Medium" />
                                                <TextBox Grid.Column="1" x:Name="TtsSherpaTokensFileTextBox" TextChanged="EditableTextChanged" VerticalAlignment="Center" />
                                            </Grid>
                                        </Border>
                                        <Border Style="{StaticResource PowerToysItemBorderStyle}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="300"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Lexicon 文件" VerticalAlignment="Center" FontWeight="Medium" />
                                                <TextBox Grid.Column="1" x:Name="TtsSherpaLexiconFileTextBox" TextChanged="EditableTextChanged" VerticalAlignment="Center" />
                                            </Grid>
                                        </Border>
                                        <Border Style="{StaticResource PowerToysItemBorderStyle}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="300"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Dict 目录" VerticalAlignment="Center" FontWeight="Medium" />
                                                <TextBox Grid.Column="1" x:Name="TtsSherpaDictDirTextBox" TextChanged="EditableTextChanged" VerticalAlignment="Center" />
                                            </Grid>
                                        </Border>
                                        <Border Style="{StaticResource PowerToysItemBorderStyle}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="300"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Rule FST 列表（逗号分隔）" VerticalAlignment="Center" FontWeight="Medium" />
                                                <TextBox Grid.Column="1" x:Name="TtsSherpaRuleFstsTextBox" TextChanged="EditableTextChanged" VerticalAlignment="Center" />
                                            </Grid>
                                        </Border>
                                        <Border Style="{StaticResource PowerToysItemBorderStyle}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="300"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Provider" VerticalAlignment="Center" FontWeight="Medium" />
                                                <TextBox Grid.Column="1" x:Name="TtsSherpaProviderTextBox" TextChanged="EditableTextChanged" VerticalAlignment="Center" />
                                            </Grid>
                                        </Border>

                                        <Border Style="{StaticResource PowerToysItemBorderStyle}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="200"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="线程数" VerticalAlignment="Center" FontWeight="Medium" />
                                                <NumberBox Grid.Column="1" x:Name="TtsSherpaThreadsNumberBox" Minimum="1" Maximum="16" ValueChanged="EditableNumberChanged" VerticalAlignment="Center" />
                                            </Grid>
                                        </Border>
                                        <Border Style="{StaticResource PowerToysItemBorderStyle}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="200"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Speaker Id" VerticalAlignment="Center" FontWeight="Medium" />
                                                <NumberBox Grid.Column="1" x:Name="TtsSherpaSpeakerNumberBox" Minimum="0" Maximum="999" ValueChanged="EditableNumberChanged" VerticalAlignment="Center" />
                                            </Grid>
                                        </Border>
                                        <Border Style="{StaticResource PowerToysItemBorderStyle}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="200"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="语速" VerticalAlignment="Center" FontWeight="Medium" />
                                                <NumberBox Grid.Column="1" x:Name="TtsSherpaSpeedNumberBox" Minimum="0.2" Maximum="3" SmallChange="0.1" ValueChanged="EditableNumberChanged" VerticalAlignment="Center" />
                                            </Grid>
                                        </Border>
                                        <Border Style="{StaticResource PowerToysItemBorderStyle}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="200"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="最大切句数" VerticalAlignment="Center" FontWeight="Medium" />
                                                <NumberBox Grid.Column="1" x:Name="TtsSherpaMaxSentencesNumberBox" Minimum="1" Maximum="20" ValueChanged="EditableNumberChanged" VerticalAlignment="Center" />
                                            </Grid>
                                        </Border>
                                        <Border Style="{StaticResource PowerToysItemBorderStyle}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="200"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Silence Scale" VerticalAlignment="Center" FontWeight="Medium" />
                                                <NumberBox Grid.Column="1" x:Name="TtsSherpaSilenceScaleNumberBox" Minimum="0" Maximum="2" SmallChange="0.1" ValueChanged="EditableNumberChanged" VerticalAlignment="Center" />
                                            </Grid>
                                        </Border>
                                        <Border Style="{StaticResource PowerToysItemBorderStyle}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="200"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Noise Scale" VerticalAlignment="Center" FontWeight="Medium" />
                                                <NumberBox Grid.Column="1" x:Name="TtsSherpaNoiseScaleNumberBox" Minimum="0" Maximum="2" SmallChange="0.1" ValueChanged="EditableNumberChanged" VerticalAlignment="Center" />
                                            </Grid>
                                        </Border>
                                        <Border Style="{StaticResource PowerToysItemBorderStyle}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="200"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Noise Scale W" VerticalAlignment="Center" FontWeight="Medium" />
                                                <NumberBox Grid.Column="1" x:Name="TtsSherpaNoiseScaleWNumberBox" Minimum="0" Maximum="2" SmallChange="0.1" ValueChanged="EditableNumberChanged" VerticalAlignment="Center" />
                                            </Grid>
                                        </Border>
                                        <Border Style="{StaticResource PowerToysItemBorderStyle}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="200"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Length Scale" VerticalAlignment="Center" FontWeight="Medium" />
                                                <NumberBox Grid.Column="1" x:Name="TtsSherpaLengthScaleNumberBox" Minimum="0.2" Maximum="3" SmallChange="0.1" ValueChanged="EditableNumberChanged" VerticalAlignment="Center" />
                                            </Grid>
                                        </Border>
                                        <Border Style="{StaticResource PowerToysItemBorderStyle}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Sherpa Debug" VerticalAlignment="Center" FontWeight="Medium" />
                                                <ToggleSwitch Grid.Column="1" x:Name="TtsSherpaDebugSwitch" Toggled="EditableRoutedChanged" VerticalAlignment="Center" Margin="0" />
                                            </Grid>
                                        </Border>
                                    </StackPanel>

                                </StackPanel>

                                <StackPanel x:Name="MemorySettingsPanel" Spacing="24" Visibility="Collapsed">
                                    <InfoBar IsOpen="True" Severity="Informational" Title="记忆目录" Message="Memory 文件夹专门保存私有数据。这里先编辑好感度和记忆路径，语义检索以后可以继续扩展。" />

                                    <StackPanel Style="{StaticResource PowerToysGroupStackStyle}">
                                        <Border Style="{StaticResource PowerToysItemBorderStyle}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="300"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Memory 文件夹" VerticalAlignment="Center" FontWeight="Medium" />
                                                <TextBox Grid.Column="1" x:Name="MemoryDirectoryTextBox" IsReadOnly="True" VerticalAlignment="Center" />
                                            </Grid>
                                        </Border>
                                        <Border Style="{StaticResource PowerToysItemBorderStyle}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="300"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="长期记忆文件" VerticalAlignment="Center" FontWeight="Medium" />
                                                <TextBox Grid.Column="1" x:Name="MemoryFileTextBox" TextChanged="EditableTextChanged" VerticalAlignment="Center" />
                                            </Grid>
                                        </Border>
                                    </StackPanel>

                                    <StackPanel Style="{StaticResource PowerToysGroupStackStyle}">
                                        <Border Style="{StaticResource PowerToysItemBorderStyle}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="300"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="好感度文件" VerticalAlignment="Center" FontWeight="Medium" />
                                                <TextBox Grid.Column="1" x:Name="FavorabilityFileTextBox" TextChanged="EditableTextChanged" VerticalAlignment="Center" />
                                            </Grid>
                                        </Border>
                                        <Border Style="{StaticResource PowerToysItemBorderStyle}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="200"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="好感度数值（0-1）" VerticalAlignment="Center" FontWeight="Medium" />
                                                <NumberBox Grid.Column="1" x:Name="FavorabilityValueNumberBox" Minimum="0" Maximum="1" SmallChange="0.05" ValueChanged="EditableNumberChanged" VerticalAlignment="Center" />
                                            </Grid>
                                        </Border>
                                        <Border Style="{StaticResource PowerToysItemBorderStyle}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="300"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="来源" VerticalAlignment="Center" FontWeight="Medium" />
                                                <TextBox Grid.Column="1" x:Name="FavorabilitySourceTextBox" TextChanged="EditableTextChanged" VerticalAlignment="Center" />
                                            </Grid>
                                        </Border>
                                    </StackPanel>

                                    <Border Style="{StaticResource PowerToysItemBorderStyle}">
                                        <StackPanel Spacing="8">
                                            <TextBlock Text="memory.jsonl 预览（只读）" FontWeight="Medium" />
                                            <TextBox x:Name="MemoryPreviewTextBox" AcceptsReturn="True" Height="220" IsReadOnly="True" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>

                                <StackPanel x:Name="AboutSettingsPanel" Spacing="24" Visibility="Collapsed">

                                    <StackPanel Style="{StaticResource PowerToysGroupStackStyle}">
                                        <Border Style="{StaticResource PowerToysItemBorderStyle}">
                                            <StackPanel Spacing="8">
                                                <TextBlock Text="项目信息" FontWeight="SemiBold" FontSize="14" />
                                                <TextBlock x:Name="AboutProjectInfoTextBlock" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Border>
                                        <Border Style="{StaticResource PowerToysItemBorderStyle}">
                                            <StackPanel Spacing="8">
                                                <TextBlock Text="当前状态" FontWeight="SemiBold" FontSize="14" />
                                                <TextBlock x:Name="AboutResourceModeTextBlock" TextWrapping="Wrap" />
                                                <TextBlock x:Name="AboutVersionTextBlock" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>

                                    <StackPanel Style="{StaticResource PowerToysGroupStackStyle}">
                                        <TextBlock Text="路径诊断" FontWeight="SemiBold" FontSize="14" Margin="4,0,0,8" />
                                        <Border Style="{StaticResource PowerToysItemBorderStyle}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="300"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="游戏程序" VerticalAlignment="Center" FontWeight="Medium" />
                                                <TextBox Grid.Column="1" x:Name="AboutGamePathTextBox" IsReadOnly="True" TextWrapping="NoWrap" VerticalAlignment="Center" />
                                            </Grid>
                                        </Border>
                                        <Border Style="{StaticResource PowerToysItemBorderStyle}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="300"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="StreamingAssets" VerticalAlignment="Center" FontWeight="Medium" />
                                                <TextBox Grid.Column="1" x:Name="AboutStreamingAssetsTextBox" IsReadOnly="True" TextWrapping="NoWrap" VerticalAlignment="Center" />
                                            </Grid>
                                        </Border>
                                        <Border Style="{StaticResource PowerToysItemBorderStyle}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="300"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="AI 配置" VerticalAlignment="Center" FontWeight="Medium" />
                                                <TextBox Grid.Column="1" x:Name="AboutAiConfigTextBox" IsReadOnly="True" TextWrapping="NoWrap" VerticalAlignment="Center" />
                                            </Grid>
                                        </Border>
                                        <Border Style="{StaticResource PowerToysItemBorderStyle}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="300"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="TTS 配置" VerticalAlignment="Center" FontWeight="Medium" />
                                                <TextBox Grid.Column="1" x:Name="AboutTtsConfigTextBox" IsReadOnly="True" TextWrapping="NoWrap" VerticalAlignment="Center" />
                                            </Grid>
                                        </Border>
                                        <Border Style="{StaticResource PowerToysItemBorderStyle}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="300"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Wisper 配置" VerticalAlignment="Center" FontWeight="Medium" />
                                                <TextBox Grid.Column="1" x:Name="AboutWhisperConfigTextBox" IsReadOnly="True" TextWrapping="NoWrap" VerticalAlignment="Center" />
                                            </Grid>
                                        </Border>
                                        <Border Style="{StaticResource PowerToysItemBorderStyle}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="300"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Memory" VerticalAlignment="Center" FontWeight="Medium" />
                                                <TextBox Grid.Column="1" x:Name="AboutMemoryPathTextBox" IsReadOnly="True" TextWrapping="NoWrap" VerticalAlignment="Center" />
                                            </Grid>
                                        </Border>
                                        <Border Style="{StaticResource PowerToysItemBorderStyle}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="300"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Unity 日志" VerticalAlignment="Center" FontWeight="Medium" />
                                                <TextBox Grid.Column="1" x:Name="AboutUnityLogPathTextBox" IsReadOnly="True" TextWrapping="NoWrap" VerticalAlignment="Center" />
                                            </Grid>
                                        </Border>
                                        <Border Style="{StaticResource PowerToysItemBorderStyle}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="300"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="启动器配置" VerticalAlignment="Center" FontWeight="Medium" />
                                                <TextBox Grid.Column="1" x:Name="AboutLauncherSettingsPathTextBox" IsReadOnly="True" TextWrapping="NoWrap" VerticalAlignment="Center" />
                                            </Grid>
                                        </Border>
                                    </StackPanel>

                                    <InfoBar
                                        IsOpen="True"
                                        IsClosable="False"
                                        Severity="Informational"
                                        Title="提示"
                                        Message="如果启动后语音、TTS、记忆或 AI 配置没有生效，请先检查这里的 StreamingAssets 是否指向当前正在运行的游戏目录。" />
                                </StackPanel>

                                <StackPanel x:Name="ExtraModuleSettingsPanel" Spacing="24" Visibility="Collapsed">
                                    <Border Style="{StaticResource PowerToysItemBorderStyle}">
                                        <StackPanel Spacing="8">
                                            <TextBlock FontSize="16" FontWeight="SemiBold" Text="额外模块暂时先不开发。" />
                                            <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="之后这里可以接插件、工具队列和模块管理。" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </ScrollViewer>

                        <Border
                            x:Name="EditableActionBar"
                            Grid.Row="3"
                            Padding="0,14,0,0"
                            Visibility="Collapsed">
                            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Spacing="8">
                                <Button x:Name="DiscardChangesButton" Click="DiscardChangesButton_Click" Content="放弃保存" />
                                <Button x:Name="SaveChangesButton" Click="SaveChangesButton_Click" Content="保存更改" Style="{StaticResource AccentButtonStyle}" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </NavigationView>
            </Border>
        </Grid>
    </Grid>
</Window>