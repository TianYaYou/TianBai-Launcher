<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="TianBai_Launcher.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="TianBai Launcher"
    mc:Ignorable="d">

    <Window.SystemBackdrop>
        <DesktopAcrylicBackdrop />
    </Window.SystemBackdrop>

    <Grid
        x:Name="RootGrid"
        Background="Transparent"
        KeyDown="RootGrid_KeyDown"
        SizeChanged="RootGrid_SizeChanged">
        <Grid.Resources>

            <Style x:Key="SettingsCardStyle" TargetType="Border">
                <Setter Property="Padding" Value="18" />
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="6" />
            </Style>
            <Style x:Key="SettingsCardStackStyle" TargetType="StackPanel">
                <Setter Property="Spacing" Value="12" />
            </Style>
            <Style x:Key="SettingsSectionTitleStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="16" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>

            <Style x:Key="PowerToysItemBorderStyle" TargetType="Border">
                <Setter Property="Padding" Value="16,12" />
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="8" />
            </Style>

            <Style x:Key="PowerToysGroupStackStyle" TargetType="StackPanel">
                <Setter Property="Spacing" Value="4" />
            </Style>
        </Grid.Resources>

        <Image
            x:Name="BackgroundImage"
            Source="Asscess/Photos/104597715_p0.jpg"
            Stretch="UniformToFill"
            Opacity="0.72" />
        <Rectangle Fill="{ThemeResource ApplicationPageBackgroundThemeBrush}" Opacity="0.26" />

        <Grid Padding="24">
            <TextBlock
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                FontSize="28"
                FontWeight="SemiBold"
                Text="TianBai" />

            <TextBlock
                Margin="0,42,0,0"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="启动器 Alpha"
                TextWrapping="Wrap" />

            <Button
                x:Name="SettingsButton"
                MinWidth="48"
                Height="48"
                HorizontalAlignment="Left"
                VerticalAlignment="Bottom"
                Click="SettingsButton_Click"
                ToolTipService.ToolTip="设置">
                <FontIcon Glyph="&#xE713;" />
            </Button>

            <StackPanel
                Width="460"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Spacing="8">
                <TextBlock
                    x:Name="LaunchPathTextBlock"
                    HorizontalAlignment="Right"
                    FontSize="12"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    TextAlignment="Right"
                    TextTrimming="CharacterEllipsis" />

                <Button
                    x:Name="LaunchButton"
                    MinWidth="172"
                    Height="48"
                    HorizontalAlignment="Right"
                    Click="LaunchButton_Click"
                    Style="{StaticResource AccentButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <FontIcon x:Name="LaunchButtonIcon" Glyph="&#xE768;" />
                        <TextBlock x:Name="LaunchButtonTextBlock" Text="开始游戏" />
                    </StackPanel>
                </Button>

                <ProgressBar
                    x:Name="LaunchProgressBar"
                    Width="130"
                    HorizontalAlignment="Right"
                    IsIndeterminate="True"
                    Value="0"
                    Visibility="Collapsed" />
            </StackPanel>
        </Grid>

        <Border
            x:Name="MainLogPanel"
            Margin="24,24,24,104"
            Padding="16"
            VerticalAlignment="Bottom"
            Background="{ThemeResource AcrylicInAppFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="16"
            Visibility="Collapsed">
            <Grid RowSpacing="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock
                    FontSize="16"
                    FontWeight="SemiBold"
                    Text="Unity Debug Log" />

                <ScrollViewer
                    x:Name="MainLogScrollViewer"
                    Grid.Row="1"
                    HorizontalScrollBarVisibility="Auto"
                    VerticalScrollBarVisibility="Auto">
                    <TextBlock
                        x:Name="MainLogTextBlock"
                        FontFamily="Consolas"
                        FontSize="12"
                        TextWrapping="NoWrap" />
                </ScrollViewer>
            </Grid>
        </Border>

        <Grid
            x:Name="SettingsOverlay"
            Opacity="0"
            Background="{ThemeResource SmokeFillColorDefaultBrush}"
            Visibility="Collapsed">
            <Grid.RenderTransform>
                <TranslateTransform x:Name="SettingsOverlayTransform" />
            </Grid.RenderTransform>

            <Border
                Background="{ThemeResource AcrylicInAppFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1,0,0,0">
                <NavigationView
                    x:Name="SettingsNavigationView"
                    Background="Transparent"
                    IsBackButtonVisible="Visible"
                    IsBackEnabled="True"
                    IsSettingsVisible="False"
                    PaneDisplayMode="Left"
                    BackRequested="SettingsNavigationView_BackRequested"
                    SelectionChanged="SettingsNavigationView_SelectionChanged">

                    <NavigationView.AutoSuggestBox>
                        <AutoSuggestBox
                            x:Name="SettingsSearchBox"
                            AutomationProperties.Name="Search"
                            DisplayMemberPath="Title"
                            PlaceholderText="搜索设置"
                            QueryIcon="Find"
                            QuerySubmitted="SettingsSearchBox_QuerySubmitted"
                            SuggestionChosen="SettingsSearchBox_SuggestionChosen"
                            TextChanged="SettingsSearchBox_TextChanged" />
                    </NavigationView.AutoSuggestBox>

                    <NavigationView.MenuItems>
                        <NavigationViewItem x:Name="LaunchSettingsItem" Content="启动" Icon="Play" />
                        <NavigationViewItem x:Name="DownloadSettingsItem" Content="下载" Icon="Download" />
                        <NavigationViewItem x:Name="ChatSettingsItem" Content="对话" Icon="Message" />
                        <NavigationViewItem x:Name="WhisperSettingsItem" Content="Wisper" Icon="Microphone" />
                        <NavigationViewItem x:Name="TtsSettingsItem" Content="TTS" Icon="Volume" />
                        <NavigationViewItem x:Name="MemorySettingsItem" Content="记忆" Icon="Library" />
                        <NavigationViewItem x:Name="AboutSettingsItem" Content="关于" Icon="ContactInfo" />
                        <NavigationViewItem x:Name="ExtraModuleSettingsItem" Content="额外模块" Icon="AllApps" />
                    </NavigationView.MenuItems>

                    <Grid Padding="32" RowSpacing="18">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Spacing="4">
                            <TextBlock
                                x:Name="SettingsTitleTextBlock"
                                FontSize="24"
                                FontWeight="SemiBold"
                                Text="启动设置" />
                            <TextBlock
                                x:Name="SettingsDescriptionTextBlock"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="配置天白 Unity 程序的启动路径。" />
                        </StackPanel>

                        <InfoBar
                            x:Name="StatusInfoBar"
                            Grid.Row="1"
                            IsOpen="True"
                            Severity="Informational"
                            Title="等待启动"
                            Message="启动器会优先自动检测大仓库 Release 目录里的天白程序。" />

                        <ScrollViewer Grid.Row="2" Padding="0,0,16,0">
                            <Grid>

                                <StackPanel x:Name="LaunchSettingsPanel" Spacing="24">
                                    <StackPanel Style="{StaticResource PowerToysGroupStackStyle}">
                                        <Border Style="{StaticResource PowerToysItemBorderStyle}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="350" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Unity 程序路径" VerticalAlignment="Center" FontWeight="Medium" />
                                                <TextBox Grid.Column="1" x:Name="GamePathTextBox" PlaceholderText="例如：E:\...\Release\Tian Bai Aic.exe" TextChanged="GamePathTextBox_TextChanged" VerticalAlignment="Center" />
                                            </Grid>
                                        </Border>

                                        <Border Style="{StaticResource PowerToysItemBorderStyle}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="350" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="自定义启动项" VerticalAlignment="Center" FontWeight="Medium" />
                                                <TextBox Grid.Column="1" x:Name="LaunchArgumentsTextBox" PlaceholderText="例如：-screen-width 1280 -screen-height 720" TextChanged="LauncherSettingsControl_Changed" VerticalAlignment="Center" />
                                            </Grid>
                                        </Border>
                                    </StackPanel>

                                    <StackPanel Style="{StaticResource PowerToysGroupStackStyle}">
                                        <Border Style="{StaticResource PowerToysItemBorderStyle}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="将日志展现主页面" VerticalAlignment="Center" FontWeight="Medium" />
                                                <ToggleSwitch Grid.Column="1" x:Name="ShowLogOnMainPageSwitch" Toggled="ShowLogOnMainPageSwitch_Toggled" VerticalAlignment="Center" Margin="0" />
                                            </Grid>
                                        </Border>

                                        <Border Style="{StaticResource PowerToysItemBorderStyle}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="200" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="展示日志行数" VerticalAlignment="Center" FontWeight="Medium" />
                                                <NumberBox Grid.Column="1" x:Name="LaunchLogLineCountNumberBox" Minimum="10" Maximum="2000" SmallChange="10" ValueChanged="LauncherSettingsNumberBox_ValueChanged" VerticalAlignment="Center" />
                                            </Grid>
                                        </Border>
                                    </StackPanel>

                                    <Border Background="{ThemeResource LayerOnAcrylicFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="16">
                                        <StackPanel Spacing="16">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="启动器控制" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="16"/>

                                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                                    <Button Click="DetectButton_Click">
                                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                                            <FontIcon Glyph="&#xE72C;" />
                                                            <TextBlock Text="重新检测" />
                                                        </StackPanel>
                                                    </Button>
                                                    <Button Click="SaveLauncherSettingsButton_Click">
                                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                                            <FontIcon Glyph="&#xE74E;" />
                                                            <TextBlock Text="保存配置" />
                                                        </StackPanel>
                                                    </Button>
                                                    <Button Click="LaunchButton_Click" Style="{StaticResource AccentButtonStyle}">
                                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                                            <FontIcon Glyph="&#xE768;" />
                                                            <TextBlock Text="启动天白" />
                                                        </StackPanel>
                                                    </Button>
                                                </StackPanel>
                                            </Grid>

                                            <StackPanel Spacing="6">
                                                <TextBlock x:Name="UnityLogPathTextBlock" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" FontSize="12" />
                                                <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="6" Background="{ThemeResource ControlFillColorDefaultBrush}">
                                                    <ScrollViewer x:Name="LaunchLogScrollViewer" Height="200" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                                                        <TextBlock x:Name="LaunchLogTextBlock" FontFamily="Consolas" FontSize="12" TextWrapping="NoWrap" Padding="12" />
                                                    </ScrollViewer>
                                                </Border>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>

                                <StackPanel x:Name="DownloadSettingsPanel" Spacing="24" Visibility="Collapsed">
                                    <Border Style="{StaticResource PowerToysItemBorderStyle}">
                                        <StackPanel Spacing="8">
                                            <TextBlock FontSize="16" FontWeight="SemiBold" Text="下载功能暂时先不开发。" />
                                            <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="之后可以在这里接入版本检查、补丁下载和模型下载。" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>

                                <StackPanel x:Name="ChatSettingsPanel" Spacing="24" Visibility="Collapsed">

                                    <StackPanel Style="{StaticResource PowerToysGroupStackStyle}">
                                        <Border Style="{StaticResource PowerToysItemBorderStyle}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="启用对话 API" VerticalAlignment="Center" FontWeight="Medium" />
                                                <ToggleSwitch Grid.Column="1" x:Name="ChatEnabledSwitch" Toggled="EditableRoutedChanged" Margin="0" VerticalAlignment="Center" />
                                            </Grid>
                                        </Border>
                                    </StackPanel>

                                    <StackPanel Style="{StaticResource PowerToysGroupStackStyle}">
                                        <Border Style="{StaticResource PowerToysItemBorderStyle}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="300"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="配置名称" VerticalAlignment="Center" FontWeight="Medium" />
                                                <TextBox Grid.Column="1" x:Name="ChatNameTextBox" TextChanged="EditableTextChanged" VerticalAlignment="Center" />
                                            </Grid>
                                        </Border>
                                        <Border Style="{StaticResource PowerToysItemBorderStyle}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="300"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="用户显示名" VerticalAlignment="Center" FontWeight="Medium" />
                                                <TextBox Grid.Column="1" x:Name="ChatUserDisplayNameTextBox" TextChanged="EditableTextChanged" VerticalAlignment="Center" />
                                            </Grid>
                                        </Border>
                                    </StackPanel>

                                    <StackPanel Style="{StaticResource PowerToysGroupStackStyle}">
                                        <Border Style="{StaticResource PowerToysItemBorderStyle}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="300"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="API Host" VerticalAlignment="Center" FontWeight="Medium" />
                                                <TextBox Grid.Column="1" x:Name="ChatApiHostTextBox" PlaceholderText="https://example.com/v1" TextChanged="EditableTextChanged" VerticalAlignment="Center" />
                                            </Grid>
                                        </Border>
                                        <Border Style="{StaticResource PowerToysItemBorderStyle}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="300"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="API Path" VerticalAlignment="Center" FontWeight="Medium" />
                                                <TextBox Grid.Column="1" x:Name="ChatApiPathTextBox" PlaceholderText="/chat/completions" TextChanged="EditableTextChanged" VerticalAlignment="Center" />
                                            </Grid>
                                        </Border>
                                        <Border Style="{StaticResource PowerToysItemBorderStyle}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="300"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="API Key" VerticalAlignment="Center" FontWeight="Medium" />
                                                <PasswordBox Grid.Column="1" x:Name="ChatApiKeyPasswordBox" PasswordChanged="EditableRoutedChanged" VerticalAlignment="Center" />
                                            </Grid>
                                        </Border>
                                    </StackPanel>

                                    <StackPanel Style="{StaticResource PowerToysGroupStackStyle}">
                                        <Border Style="{StaticResource PowerToysItemBorderStyle}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="300"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="默认模型" VerticalAlignment="Center" FontWeight="Medium" />
                                                <TextBox Grid.Column="1" x:Name="ChatModelTextBox" TextChanged="EditableTextChanged" VerticalAlignment="Center" />
                                            </Grid>
                                        </Border>
                                        <Border Style="{StaticResource PowerToysItemBorderStyle}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="300"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="模型列表（逗号分隔）" VerticalAlignment="Center" FontWeight="Medium" />
                                                <TextBox Grid.Column="1" x:Name="ChatModelListTextBox" TextChanged="EditableTextChanged" VerticalAlignment="Center" />
                                            </Grid>
                                        </Border>
                                        <Border Style="{StaticResource PowerToysItemBorderStyle}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="200"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Temperature" VerticalAlignment="Center" FontWeight="Medium" />
                                                <NumberBox Grid.Column="1" x:Name="ChatTemperatureNumberBox" Minimum="0" Maximum="2" SmallChange="0.1" ValueChanged="EditableNumberChanged" VerticalAlignment="Center" />
                                            </Grid>
                                        </Border>
                                    </StackPanel>

                                    <StackPanel Style="{StaticResource PowerToysGroupStackStyle}">
                                        <Border Style="{StaticResource PowerToysItemBorderStyle}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="流式输出" VerticalAlignment="Center" FontWeight="Medium" />
                                                <ToggleSwitch Grid.Column="1" x:Name="ChatStreamSwitch" Toggled="EditableRoutedChanged" VerticalAlignment="Center" Margin="0" />
                                            </Grid>
                                        </Border>
                                        <Border Style="{StaticResource PowerToysItemBorderStyle}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="携带历史对话" VerticalAlignment="Center" FontWeight="Medium" />
                                                <ToggleSwitch Grid.Column="1" x:Name="ChatPassHistorySwitch" Toggled="EditableRoutedChanged" VerticalAlignment="Center" Margin="0" />
                                            </Grid>
                                        </Border>
                                        <Border Style="{StaticResource PowerToysItemBorderStyle}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="兼容旧 JSON 输出" VerticalAlignment="Center" FontWeight="Medium" />
                                                <ToggleSwitch Grid.Column="1" x:Name="ChatLegacyJsonSwitch" Toggled="EditableRoutedChanged" VerticalAlignment="Center" Margin="0" />
                                            </Grid>
                                        </Border>
                                    </StackPanel>

                                    <StackPanel Style="{StaticResource PowerToysGroupStackStyle}">
                                        <Border Style="{StaticResource PowerToysItemBorderStyle}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="使用 Prompt 文件" VerticalAlignment="Center" FontWeight="Medium" />
                                                <ToggleSwitch Grid.Column="1" x:Name="ChatUsePromptFileSwitch" Toggled="EditableRoutedChanged" VerticalAlignment="Center" Margin="0" />
                                            </Grid>
                                        </Border>
                                        <Border Style="{StaticResource PowerToysItemBorderStyle}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="300"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="System Prompt 文件路径" VerticalAlignment="Center" FontWeight="Medium" />
                                                <TextBox Grid.Column="1" x:Name="ChatSystemPromptFileTextBox" TextChanged="EditableTextChanged" VerticalAlignment="Center" />
                                            </Grid>
                                        </Border>

                                        <Border Style="{StaticResource PowerToysItemBorderStyle}">
                                            <StackPanel Spacing="8">
                                                <TextBlock Text="默认 System Prompt" FontWeight="Medium" />
                                                <TextBox x:Name="ChatDefaultSystemPromptTextBox" AcceptsReturn="True" Height="110" TextWrapping="Wrap" TextChanged="EditableTextChanged" />
                                            </StackPanel>
                                        </Border>
                                        <Border Style="{StaticResource PowerToysItemBorderStyle}">
                                            <StackPanel Spacing="8">
                                                <TextBlock Text="dialogue_prompt.txt" FontWeight="Medium" />
                                                <TextBox x:Name="DialoguePromptTextBox" AcceptsReturn="True" Height="220" TextWrapping="Wrap" TextChanged="EditableTextChanged" />
                                            </StackPanel>
                                        </Border>
                                        <Border Style="{StaticResource PowerToysItemBorderStyle}">
                                            <StackPanel Spacing="8">
                                                <TextBlock Text="control_planner_prompt.txt" FontWeight="Medium" />
                                                <TextBox x:Name="ControlPlannerPromptTextBox" AcceptsReturn="True" Height="260" TextWrapping="Wrap" TextChanged="EditableTextChanged" />
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </StackPanel>

                                <StackPanel x:Name="WhisperSettingsPanel" Spacing="24" Visibility="Collapsed">
                                    <InfoBar IsOpen="True" Severity="Informational" Title="Wisper 配置" Message="这里先写入 AI/whisper_config.json；Unity 侧后续接入后即可读取同一份配置。" />

                                    <StackPanel Style="{StaticResource PowerToysGroupStackStyle}">
                                        <Border Style="{StaticResource PowerToysItemBorderStyle}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="启用语音唤醒" VerticalAlignment="Center" FontWeight="Medium" />
                                                <ToggleSwitch Grid.Column="1" x:Name="WhisperEnabledSwitch" Toggled="EditableRoutedChanged" VerticalAlignment="Center" Margin="0" />
                                            </Grid>
                                        </Border>
                                        <Border Style="{StaticResource PowerToysItemBorderStyle}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="唤醒词后带指令时直接提交" VerticalAlignment="Center" FontWeight="Medium" />
                                                <ToggleSwitch Grid.Column="1" x:Name="WhisperSubmitTailSwitch" Toggled="EditableRoutedChanged" VerticalAlignment="Center" Margin="0" />
                                            </Grid>
                                        </Border>
                                    </StackPanel>

                                    <StackPanel Style="{StaticResource PowerToysGroupStackStyle}">
                                        <Border Style="{StaticResource PowerToysItemBorderStyle}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="300"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="唤醒词" VerticalAlignment="Center" FontWeight="Medium" />
                                                <TextBox Grid.Column="1" x:Name="WhisperWakeWordTextBox" TextChanged="EditableTextChanged" VerticalAlignment="Center" />
                                            </Grid>
                                        </Border>
                                        <Border Style="{StaticResource PowerToysItemBorderStyle}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="300"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="模型文件（相对或绝对路径）" VerticalAlignment="Center" FontWeight="Medium" />
                                                <TextBox Grid.Column="1" x:Name="WhisperModelFileTextBox" PlaceholderText="Whisper/ggml-tiny.bin" TextChanged="EditableTextChanged" VerticalAlignment="Center" />
                                            </Grid>
                                        </Border>
                                    </StackPanel>

                                    <StackPanel Style="{StaticResource PowerToysGroupStackStyle}">
                                        <Border Style="{StaticResource PowerToysItemBorderStyle}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="200"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="唤醒静音判定秒数" VerticalAlignment="Center" FontWeight="Medium" />
                                                <NumberBox Grid.Column="1" x:Name="WhisperWakeSilenceNumberBox" Minimum="0.1" Maximum="10" SmallChange="0.1" ValueChanged="EditableNumberChanged" VerticalAlignment="Center" />
                                            </Grid>
                                        </Border>
                                        <Border Style="{StaticResource PowerToysItemBorderStyle}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="200"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="指令静音判定秒数" VerticalAlignment="Center" FontWeight="Medium" />
                                                <NumberBox Grid.Column="1" x:Name="WhisperCommandSilenceNumberBox" Minimum="0.1" Maximum="10" SmallChange="0.1" ValueChanged="EditableNumberChanged" VerticalAlignment="Center" />
                                            </Grid>
                                        </Border>
                                        <Border Style="{StaticResource PowerToysItemBorderStyle}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="200"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="AI 回答后重新监听延迟秒数" VerticalAlignment="Center" FontWeight="Medium" />
                                                <NumberBox Grid.Column="1" x:Name="WhisperRestartDelayNumberBox" Minimum="0" Maximum="5" SmallChange="0.1" ValueChanged="EditableNumberChanged" VerticalAlignment="Center" />
                                            </Grid>
                                        </Border>
                                    </StackPanel>
                                </StackPanel>

                                <StackPanel x:Name="TtsSettingsPanel" Spacing="24" Visibility="Collapsed">
                                    <InfoBar x:Name="TtsParseWarningInfoBar" IsOpen="False" Severity="Warning" Title="TTS 配置需要修复" />

                                    <StackPanel Style="{StaticResource PowerToysGroupStackStyle}">
                                        <Border Style="{StaticResource PowerToysItemBorderStyle}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="启用 TTS" VerticalAlignment="Center" FontWeight="Medium" />
                                                <ToggleSwitch Grid.Column="1" x:Name="TtsEnabledSwitch" Toggled="EditableRoutedChanged" VerticalAlignment="Center" Margin="0" />
                                            </Grid>
                                        </Border>
                                        <Border Style="{StaticResource PowerToysItemBorderStyle}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="300"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="配置名称" VerticalAlignment="Center" FontWeight="Medium" />
                                                <TextBox Grid.Column="1" x:Name="TtsNameTextBox" TextChanged="EditableTextChanged" VerticalAlignment="Center" />
                                            </Grid>
                                        </Border>
                                        <Border Style="{StaticResource PowerToysItemBorderStyle}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="300"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="运行模式" VerticalAlignment="Center" FontWeight="Medium" />
